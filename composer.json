{
    "name": "timeoutdigital/memcache-bundle",
    "type": "symfony-bundle",
    "description": "Memcache Doctrine caching and session storage in the Web Debug Toolbar",
    "keywords": ["memcache", "memcached", "cache", "session"],
    "homepage": "http://www.leaseweblabs.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Maurits van der Schee",
            "email": "m.vanderschee@leaseweb.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/framework-bundle": "^7.0.3",
        "ext-memcache": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Lsw\\MemcacheBundle\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
